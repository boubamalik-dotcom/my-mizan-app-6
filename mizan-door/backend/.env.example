# PostgreSQL connection (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mizan_door

# Redis connection (used starting in Step 2 - real-time engine)
REDIS_URL=redis://localhost:6379/0

# App
APP_NAME=Mizan Door
DEBUG=true

# CORS - comma separated list of allowed origins for the clinic dashboard.
# If testing frontend_mobile as a Flutter *web* build (e.g. `flutter run -d
# chrome --web-port=5001`), add its origin here too, e.g.
# http://127.0.0.1:5001 (native Android/iOS builds aren't subject to CORS).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Clinic staff authentication (JWT). The default secret below is ONLY for
# local development - generate a real one for any shared/deployed
# environment, e.g.: python3 -c "import secrets; print(secrets.token_hex(32))"
# Anyone who knows this secret can forge a valid login token for any clinic.
JWT_SECRET_KEY=dev-insecure-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
